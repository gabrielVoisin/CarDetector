# Options of plate_sensor/reader.py when it runs as the parking-reader service (see `reader.py --help`).
# Copy to reader.env. After editing:  systemctl --user restart parking-reader
#   --rotate          turn the picture clockwise (0, 90, 180, 270) so plates are upright
#   --max-fps         AI analysis rate; the live view stays at ~30 fps
#   --hot-temp/--hot-fps/--pause-temp/--resume-temp   thermal protection of the Pi (°C, frames/s)
#   --detector-url    cabinet agent endpoint of this presence sensor (CP-001 of CTRL-01)
#   --server/--api-key-file   optional: also report plates to the old Smart Parking web app
READER_ARGS=--rotate 0 --max-fps 3 --hot-temp 75 --hot-fps 1 --pause-temp 82 --resume-temp 70 --device-code CP-001 --detector-url http://127.0.0.1:8090/detectors/CP-001 --http-host 0.0.0.0 --http-port 8081
