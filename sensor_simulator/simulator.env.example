# Copy to simulator.env (not committed). The simulator plays cabinet CTRL-01's simulated sensors.
SERVER_URL=http://localhost
# Key of cabinet CTRL-01 (the demo key below is the one of the seed data; use yours if you changed it)
CONTROLLER_KEY=ctrl0001.demo-secret-change-me-1
# The page is open to the local network (no password): only fake readings can be sent from it
LISTEN=0.0.0.0:8082
